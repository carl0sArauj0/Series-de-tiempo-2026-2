library(readxl)
ISE2005_2026 <- read_excel("~/Documents/Github/Series-de-tiempo-2026-2/ISE2005_2026.xlsx")
View(ISE2005_2026)
paquetes <- c(
"readxl", "tidyverse", "lubridate", "zoo", "xts",
"tsibble", "feasts", "fable", "timetk", "forecast",
"TSstudio", "astsa", "nonlinearTseries", "tseriesChaos",
"energy", "biwavelet", "knitr", "rmarkdown"
)
nuevos <- paquetes[!(paquetes %in% rownames(installed.packages()))]
if (length(nuevos)) install.packages(nuevos, dependencies = TRUE)
install.packages("gsl")
install.packages("energy")
